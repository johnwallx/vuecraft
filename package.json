{
  "name": "vuecraft",
  "private": true,
  "version": "0.1.0-beta.1",
  "type": "module",
  "license": "MIT OR Apache-2.0",
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:guard": "node scripts/if-present.mjs .claude/hooks/cleanroom-guard.mjs -- node --test \"tests/cleanroom/**/*.test.mjs\" \".claude/skills/clean-room/scripts/tests/*.test.mjs\"",
    "test:desktop": "node scripts/desktop-e2e.mjs --build",
    "test:e2e:playwright-legacy": "playwright test",
    "audit:licenses": "node scripts/check-licenses.mjs",
    "tauri": "tauri",
    "test:hooks": "node scripts/if-present.mjs .claude/hooks/harness.mjs -- node --test \"tests/harness/**/*.test.mjs\"",
    "verify": "node scripts/verify.mjs",
    "lsp:check": "node scripts/lsp-smoke.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tiptap/pm": "^3.33.0",
    "@tiptap/react": "^3.33.0",
    "@tiptap/starter-kit": "^3.33.0",
    "@xyflow/react": "^12.12.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "~6.2.1",
    "@wdio/cli": "^9.33.1",
    "@wdio/local-runner": "^9.33.1",
    "@wdio/mocha-framework": "^9.33.1",
    "@wdio/spec-reporter": "^9.33.1",
    "@wdio/tauri-plugin": "1.5.1",
    "@wdio/tauri-service": "1.5.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "~8.3.6",
    "vitest": "^5.1.0",
    "webdriverio": "^9.33.1"
  }
}
